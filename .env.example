# Optional overrides. The evolution agent is disabled by default; enable it in
# the live control panel when periodic report generation is intended.
MINIMAX_API_KEY=
# World-fragment generation uses a fast creative route independently from the
# longer-form evolution report model. Five concurrent ten-item calls fill 50.
WORLD_FRAGMENT_MODEL=MiniMax-M2.7-highspeed
WORLD_FRAGMENT_MAX_CONCURRENCY=5
WORLD_FRAGMENT_TIMEOUT_MS=120000
# Optional hard stop: set to false to prevent the agent from running even when
# it is enabled in the live control panel.
# TYPHOON_EVOLUTION_AGENT_ENABLED=false
WEATHER_API_USER_AGENT=TyphoonBossRadar/1.0 admin@example.com

# Optional: enables China 1km / 5-minute precipitation and official alerts in
# /api/city-briefing. Use the dedicated API Host shown in QWeather Console
# Settings. JWT is required by the v1 official-alert endpoint. Keep its private
# key server-only, either as an escaped PEM or at an absolute local path.
QWEATHER_API_HOST=https://your-project.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_JWT_PROJECT_ID=
QWEATHER_JWT_KEY_ID=
# QWEATHER_JWT_PRIVATE_KEY_PATH=D:/typhoon boss radar/.secrets/qweather-ed25519-private.pem
# QWEATHER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
